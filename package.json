{
	"name": "dis-gravity",
	"displayName": "Dis-Gravity",
	"description": "Dis-Gravity - The ultimate Discord bridge for your IDE",
	"version": "1.0.0",
	"publisher": "anonk",
	"icon": "media/icon.png",
	"license": "MIT",
	"preview": false,

	"keywords": [
		"discord",
		"chat",
		"bridge",
		"ai",
		"language-model",
		"copilot",
		"gemini"
	],
	"galleryBanner": {
		"color": "#5865F2",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.93.0"
	},
	"categories": [
		"Chat",
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"extensionKind": [
		"ui"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "antigravity-discord",
					"title": "Discord",
					"icon": "media/discord.svg"
				}
			]
		},
		"views": {
			"antigravity-discord": [
				{
					"type": "webview",
					"id": "antigravity-discord.chatView",
					"name": "Discord Chat"
				}
			]
		},
		"commands": [
			{
				"command": "antigravity-discord.reconnect",
				"title": "Dis-Gravity: Reconnect"
			}
		],
		"configuration": {
			"title": "Dis-Gravity",
			"properties": {
				"antigravity-discord.botToken": {
					"type": "string",
					"default": "",
					"description": "Discord Bot Token"
				},
				"antigravity-discord.channelId": {
					"type": "string",
					"default": "",
					"description": "Discord Channel ID to bridge"
				},
				"antigravity-discord.debugPort": {
					"type": "number",
					"default": 9000,
					"description": "Antigravity remote debugging port (--remote-debugging-port)"
				},
				"antigravity-discord.autoAccept": {
					"type": "boolean",
					"default": true,
					"description": "Auto-click Accept/Run/Always Allow buttons during Discord message processing"
				}
			}
		}
	},
	"scripts": {
		"compile": "node esbuild.js",
		"compile:production": "node esbuild.js --production",
		"watch": "node esbuild.js --watch",
		"lint": "eslint src",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepackage": "npm run compile:production",
		"package": "vsce package"
	},
	"dependencies": {
		"discord.js": "^14.16.0",
		"ws": "^8.19.0"
	},
	"devDependencies": {
		"@types/vscode": "^1.93.0",
		"@types/ws": "^8.18.1",
		"@vscode/vsce": "^3.7.1",
		"esbuild": "^0.25.1",
		"typescript": "^5.5.0",
		"vitest": "^4.0.18"
	},
	"__metadata": {
		"targetPlatform": "universal",
		"isApplicationScoped": false,
		"isBuiltin": false
	}
}